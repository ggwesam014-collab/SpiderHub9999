----------------------------------------------------------------
-- Control Animations (تعطيل/إعادة الأنميشن)
----------------------------------------------------------------
local function ManageAnimations(enable)
    pcall(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if not enable then
                local animator = hum:FindFirstChildOfClass("Animator")
                if animator then animator:Destroy() end
                for _, track in pairs(hum:GetPlayingAnimationTracks()) do
                    track:Stop()
                end
            else
                if not hum:FindFirstChildOfClass("Animator") then
                    Instance.new("Animator", hum)
                end
            end
        end
    end)
end

----------------------------------------------------------------
-- Equip Weapon
----------------------------------------------------------------
local function EquipWeapon(weaponType)
    local character = LocalPlayer.Character
    if not character then return end
    
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (weaponType == "Melee" and item.ToolTip == "Melee") or
               (weaponType == "Sword" and item.ToolTip == "Sword") or
               (weaponType == "Blox Fruit" and item.ToolTip == "Blox Fruit") then
                character.Humanoid:EquipTool(item)
                break
            end
        end
    end
end

----------------------------------------------------------------
-- Big Hitbox
----------------------------------------------------------------
local function MakeBigHitbox(enemy)
    if enemy and enemy:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = enemy.HumanoidRootPart
            hrp.Size = Vector3.new(75, 75, 75)
            hrp.Transparency = 0.6
            hrp.Color = Color3.fromRGB(255, 0, 0)
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
        end)
    end
end

----------------------------------------------------------------
-- Fast Auto Hit System (الضرب التلقائي)
----------------------------------------------------------------
local function StartAutoHit()
    task.spawn(function()
        while AutoFarm do
            task.wait(0.01)
            if CurrentTarget and CurrentTarget:FindFirstChild("Humanoid") and CurrentTarget.Humanoid.Health > 0 then
                pcall(function()
                    EquipWeapon(SelectedWeapon)
                    
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    
                    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
                    if net then
                        if net:FindFirstChild("RegisterAttack") then net.RegisterAttack:FireServer(0) end
                        if net:FindFirstChild("RegisterHits") and CurrentTarget:FindFirstChild("HumanoidRootPart") then
                            net.RegisterHits:FireServer(CurrentTarget.HumanoidRootPart, {CurrentTarget})
                        end
                    end
                end)
            end
        end
    end)
end

----------------------------------------------------------------
-- Smart Flight Tween (ارتفاع 40m وتوقف 0.1 ثانية بالهواء)
----------------------------------------------------------------
local function FlyTween(targetCFrame)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    local startPos = rootPart.Position
    local endPos = targetCFrame.Position
    local flyHeight = math.max(startPos.Y, endPos.Y) + 40
    
    local highTargetPos = Vector3.new(endPos.X, flyHeight, endPos.Z)
    local speed = 300

    -- الطيران إلى النقطة العالية فوق الهدف
    while AutoFarm and (rootPart.Position - highTargetPos).Magnitude > 8 do
        local dt = RunService.Heartbeat:Wait()
        local currentPos = rootPart.Position
        local direction = (highTargetPos - currentPos).Unit
        local distance = (highTargetPos - currentPos).Magnitude
        
        local moveStep = math.min(distance, speed * dt)
        rootPart.CFrame = CFrame.new(currentPos + (direction * moveStep), highTargetPos)
        rootPart.Velocity = Vector3.zero
    end
    
    -- التوقف بالهواء لمدة 0.1 ثانية لتفادي التعليق
    if AutoFarm then
        rootPart.Velocity = Vector3.zero
        task.wait(0.1)
    end
    
    -- النزول المباشر للهدف
    if AutoFarm then
        rootPart.CFrame = targetCFrame
        rootPart.Velocity = Vector3.zero
    end
end

