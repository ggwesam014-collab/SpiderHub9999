local function GetCurrentQuestData()
    local level = LocalPlayer.Data.Level.Value
    for _, q in pairs(QuestDatabase) do
        if level >= q.MinLvl and level <= q.MaxLvl then
            return q
        end
    end
    return QuestDatabase[1]
end

local function CheckAndGetQuest(questData)
    local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
    local questUI = mainGui and mainGui:FindFirstChild("Quest")
    
    if not questUI or not questUI.Visible then
        DirectTween(questData.NPC)
        task.wait(0.2)
        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questData.QuestName, 1)
        task.wait(0.3)
    end
end

-- Main Auto Farm Loop
local function StartAutoFarm()
    StartAutoHit()
    
    task.spawn(function()
        while AutoFarm do
            task.wait(0.1)
            local questData = GetCurrentQuestData()
            
            if questData then
                CheckAndGetQuest(questData)
                DirectTween(questData.Area)
                
                for _, monster in pairs(Workspace.Enemies:GetChildren()) do
                    if monster.Name == questData.Monster and monster:FindFirstChild("Humanoid") and monster.Humanoid.Health > 0 then
                        CurrentTarget = monster
                        
                        while AutoFarm and CurrentTarget and CurrentTarget.Parent and CurrentTarget.Humanoid.Health > 0 do
                            task.wait(0.02)
                            ApplyHitbox(CurrentTarget)
                            
                            -- الوقوف فوق العدو بمسافة 11 وحدة لعدم تلقي أي ضرر منه
                            local safeTargetCFrame = CurrentTarget.HumanoidRootPart.CFrame * CFrame.new(0, 11, 0)
                            LocalPlayer.Character.HumanoidRootPart.CFrame = safeTargetCFrame
                            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.zero
                            
                            EquipWeapon(SelectedWeapon)
                        end
                        
                        repeat task.wait() until not CurrentTarget or not CurrentTarget.Parent
                    end
                end
            end
        end
    end)
end

