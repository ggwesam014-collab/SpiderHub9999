----------------------------------------------------------------
-- Straight Line Tween (توين مباشر بدون صعود ونزول)
----------------------------------------------------------------
local function DirectTween(targetCFrame)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    local speed = 250
    local targetPos = targetCFrame.Position
    
    while AutoFarm and (rootPart.Position - targetPos).Magnitude > 5 do
        local dt = RunService.Heartbeat:Wait()
        local currentPos = rootPart.Position
        local direction = (targetPos - currentPos).Unit
        local distance = (targetPos - currentPos).Magnitude
        
        local moveStep = math.min(distance, speed * dt)
        local newPos = currentPos + (direction * moveStep)
        
        rootPart.CFrame = CFrame.new(newPos, targetPos)
        rootPart.Velocity = Vector3.zero -- إلغاء السرعة لتفادي إرجاعك للخلف
    end
    
    rootPart.CFrame = targetCFrame
    rootPart.Velocity = Vector3.zero
end

----------------------------------------------------------------
-- Hitbox Magnifier (تكبير الهيت بوكس لضمان وصول الضرر)
----------------------------------------------------------------
local function ApplyHitbox(monster)
    if not monster or not monster:FindFirstChild("HumanoidRootPart") then return end
    pcall(function()
        local hrp = monster.HumanoidRootPart
        hrp.Size = Vector3.new(60, 60, 60)
        hrp.Transparency = 0.7
        hrp.Color = Color3.fromRGB(255, 0, 0)
        hrp.Material = Enum.Material.Neon
        hrp.CanCollide = false
    end)
end

----------------------------------------------------------------
-- Working Auto Hit System (نظام الضرب المباشر السريع)
----------------------------------------------------------------
local function StartAutoHit()
    task.spawn(function()
        while AutoFarm do
            task.wait(0.05)
            if CurrentTarget and CurrentTarget:FindFirstChild("Humanoid") and CurrentTarget.Humanoid.Health > 0 then
                pcall(function()
                    local character = LocalPlayer.Character
                    if not character then return end
                    
                    local tool = character:FindFirstChildOfClass("Tool")
                    if tool then
                        -- تفعيل الأداة
                        tool:Activate()
                        
                        -- تنفيذ ضربات المحاكاة المباشرة
                        VirtualUser:CaptureController()
                        VirtualUser:Button1Down(Vector2.new(0, 0))
                        
                        -- استدعاء ريموت الهجوم القريب إن وجد بالسيرفر
                        local netModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
                        if netModule then
                            local RegisterAttack = ReplicatedStorage.Modules.Net:FindFirstChild("RegisterAttack")
                            local RegisterHits = ReplicatedStorage.Modules.Net:FindFirstChild("RegisterHits")
                            if RegisterAttack then RegisterAttack:FireServer(0.1) end
                            if RegisterHits then RegisterHits:FireServer(CurrentTarget.HumanoidRootPart, {CurrentTarget}) end
                        end
                    end
                end)
            end
        end
    end)
end

----------------------------------------------------------------
-- Equip Weapon
----------------------------------------------------------------
local function EquipWeapon(weaponType)
    local character = LocalPlayer.Character
    if not character then return end
    
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (weaponType == "Melee" and item.ToolTip == "Melee") or
               (weaponType == "Sword" and item.ToolTip == "Sword") or
               (weaponType == "Blox Fruit" and item.ToolTip == "Blox Fruit") then
                character.Humanoid:EquipTool(item)
                break
            end
        end
    end
end

