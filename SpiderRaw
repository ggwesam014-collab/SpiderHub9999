local function GetCurrentQuestData()
    local level = LocalPlayer.Data.Level.Value
    local placeId = game.PlaceId
    
    local questList = Sea1_Quests
    if placeId == 4442272183 then
        questList = Sea2_Quests
    elseif placeId == 7449423635 then
        questList = Sea3_Quests
    end
    
    for _, q in pairs(questList) do
        if level >= q.MinLvl and level <= q.MaxLvl then
            return q
        end
    end
    return questList[#questList]
end

----------------------------------------------------------------
-- Check Quest Status (فحص حالة المهمة الحالية)
----------------------------------------------------------------
local function HasQuest()
    local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
    local questUI = mainGui and mainGui:FindFirstChild("Quest")
    return questUI and questUI.Visible and questUI.Container.QuestTitle.Title.Text ~= ""
end

local function EnsureQuest(questData)
    if HasQuest() or GettingQuest then return end
    
    GettingQuest = true
    FlyTween(questData.NPC)
    task.wait(0.2)
    
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questData.QuestName, 1)
    end)
    
    task.wait(0.4)
    GettingQuest = false
end

----------------------------------------------------------------
-- Main Auto Farm Loop
----------------------------------------------------------------
local function StartAutoFarm()
    ManageAnimations(false)
    StartAutoHit()
    
    task.spawn(function()
        while AutoFarm do
            task.wait(0.02)
            local questData = GetCurrentQuestData()
            
            if questData then
                -- إذا لم تكن هناك مهمة مأخوذة، يذهب فوراً لأخذها
                if not HasQuest() then
                    EnsureQuest(questData)
                else
                    -- إذا كانت المهمة مأخوذة، يبدأ بالقتال مباشرة
                    local foundEnemy = false
                    for _, monster in pairs(Workspace.Enemies:GetChildren()) do
                        if monster.Name == questData.Monster and monster:FindFirstChild("Humanoid") and monster.Humanoid.Health > 0 then
                            foundEnemy = true
                            CurrentTarget = monster
                            
                            while AutoFarm and CurrentTarget and CurrentTarget.Parent and CurrentTarget.Humanoid.Health > 0 and HasQuest() do
                                task.wait(0.01)
                                MakeBigHitbox(CurrentTarget)
                                
                                local targetCFrame = CurrentTarget.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0)
                                LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame
                                LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.zero
                            end
                            
                            CurrentTarget = nil
                            break
                        end
                    end
                    
                    if not foundEnemy then
                        FlyTween(questData.Area)
                    end
                end
            end
        end
    end)
end

