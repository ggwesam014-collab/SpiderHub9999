----------------------------------------------------------------
-- Fixed Camera System (تتبع الكاميرا بسلاسة بدون أي اهتزاز)
----------------------------------------------------------------
local CameraConnection = nil

local function StartCameraFollow()
    if CameraConnection then CameraConnection:Disconnect() end
    
    Camera.CameraType = Enum.CameraType.Scriptable
    CameraConnection = RunService.RenderStepped:Connect(function()
        if AutoFarm and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character.HumanoidRootPart
            -- الكاميرا تتبع اللاعب من الخلف بمسافة ثابتة لمنع الاهتزاز
            Camera.CFrame = CFrame.new(root.Position + Vector3.new(0, 12, 15), root.Position)
        end
    end)
end

local function StopCameraFollow()
    if CameraConnection then
        CameraConnection:Disconnect()
        CameraConnection = nil
    end
    Camera.CameraType = Enum.CameraType.Custom
end

----------------------------------------------------------------
-- Custom Smooth Tween System (تنقل آمن وسلس عبر الهواء)
----------------------------------------------------------------
local function CustomTween(targetCFrame)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    local startPos = rootPart.Position
    local endPos = targetCFrame.Position
    local flyHeight = math.max(startPos.Y, endPos.Y) + 40
    
    local waypoints = {
        Vector3.new(startPos.X, flyHeight, startPos.Z),
        Vector3.new(endPos.X, flyHeight, endPos.Z),
        endPos
    }

    local speed = 220
    
    for _, waypoint in ipairs(waypoints) do
        while AutoFarm and (rootPart.Position - waypoint).Magnitude > 4 do
            local dt = RunService.Heartbeat:Wait()
            local currentPos = rootPart.Position
            local direction = (waypoint - currentPos).Unit
            local distance = (waypoint - currentPos).Magnitude
            
            local moveStep = math.min(distance, speed * dt)
            local newPos = currentPos + (direction * moveStep)
            
            rootPart.CFrame = CFrame.new(newPos, waypoint)
            rootPart.Velocity = Vector3.zero
        end
    end
    
    rootPart.CFrame = targetCFrame
end

----------------------------------------------------------------
-- Working Big Hitbox (تكبير وتعديل الهيت بوكس بشكل صحيح)
----------------------------------------------------------------
local function ExpandHitbox(monster)
    if not monster then return end
    
    pcall(function()
        local hrp = monster:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Size = Vector3.new(45, 45, 45)
            hrp.Transparency = 0.6
            hrp.Color = Color3.fromRGB(255, 0, 0)
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
        end
    end)
end

----------------------------------------------------------------
-- Auto Attack & Equip Weapon
----------------------------------------------------------------
local function EquipWeapon(weaponType)
    local character = LocalPlayer.Character
    if not character then return end
    
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (weaponType == "Melee" and item.ToolTip == "Melee") or
               (weaponType == "Sword" and item.ToolTip == "Sword") or
               (weaponType == "Blox Fruit" and item.ToolTip == "Blox Fruit") then
                character.Humanoid:EquipTool(item)
                break
            end
        end
    end
end

local function FastAttackLoop()
    task.spawn(function()
        while AutoFarm do
            task.wait(0.08)
            if CurrentTarget and CurrentTarget:FindFirstChild("Humanoid") and CurrentTarget.Humanoid.Health > 0 then
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(Vector2.new(0, 0))
                    
                    local character = LocalPlayer.Character
                    if character then
                        local tool = character:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                    end
                end)
            end
        end
    end)
end

