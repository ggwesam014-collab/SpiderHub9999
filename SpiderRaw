local function GetCurrentQuestData()
    local level = LocalPlayer.Data.Level.Value
    for _, q in pairs(QuestDatabase) do
        if level >= q.MinLvl and level <= q.MaxLvl then
            return q
        end
    end
    return QuestDatabase[1]
end

local function ManageQuest(questData)
    local questUI = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
    
    if questUI and questUI.Visible then
        if not string.find(questUI.Container.QuestTitle.Title.Text, questData.Monster) then
            ReplicatedStorage.Remotes.CommF_:InvokeServer("AbandonQuest")
            task.wait(0.5)
        else
            return true
        end
    end
    
    CustomTween(questData.NPC)
    task.wait(0.3)
    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questData.QuestName, 1)
    return true
end

-- Main Auto Farm Loop
local function StartAutoFarm()
    StartCameraFollow()
    FastAttackLoop()
    
    task.spawn(function()
        while AutoFarm do
            task.wait()
            local questData = GetCurrentQuestData()
            
            if questData then
                ManageQuest(questData)
                CustomTween(questData.Area)
                
                for _, monster in pairs(Workspace.Enemies:GetChildren()) do
                    if monster.Name == questData.Monster and monster:FindFirstChild("Humanoid") and monster.Humanoid.Health > 0 then
                        CurrentTarget = monster
                        
                        while AutoFarm and CurrentTarget and CurrentTarget.Parent and CurrentTarget.Humanoid.Health > 0 do
                            task.wait()
                            ExpandHitbox(CurrentTarget)
                            
                            -- الطيران فوق الهدف بمسافة ثابته
                            local targetCFrame = CurrentTarget.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                            LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame
                            
                            EquipWeapon(SelectedWeapon)
                        end
                        
                        repeat task.wait() until not CurrentTarget or not CurrentTarget.Parent
                    end
                end
            end
        end
    end)
end

